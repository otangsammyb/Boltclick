# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy to .env and fill in EVERY value before deploying
#  DO NOT commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BASE_URL=https://yourdomain.com

# ── MongoDB (self-hosted inside Docker — zero Atlas fees) ─────────────────────
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASS
MONGO_BOT_PASSWORD=CHANGE_ME_STRONG_BOT_PASS
# The MONGO_URI used by the app (inside Docker, mongo = service hostname):
MONGO_URI=mongodb://botuser:CHANGE_ME_STRONG_BOT_PASS@mongo:27017/restaurant_bot?authSource=restaurant_bot

# ── MongoDB Express (dev profile only) ───────────────────────────────────────
ME_USERNAME=mongoadmin
ME_PASSWORD=CHANGE_ME_ME_PASS

# ── Meta / WhatsApp ───────────────────────────────────────────────────────────
META_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_TOKEN=your_whatsapp_token
META_VERIFY_TOKEN=your_custom_verify_token
META_API_VERSION=v19.0
META_APP_ID=
META_APP_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_WHATSAPP=237XXXXXXXXX
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASS

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX

# ── Restaurant ────────────────────────────────────────────────────────────────
RESTAURANT_NAME=My Restaurant
RESTAURANT_ADDRESS=123 Main St, Douala, Cameroon
RESTAURANT_PHONE=237XXXXXXXXX
RESTAURANT_LAT=4.061536
RESTAURANT_LNG=9.742195
TOTAL_TABLES=10
DELIVERY_FEE_PER_KM=200

# ── CamPay ───────────────────────────────────────────────────────────────────
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password
CAMPAY_APP_NAME=RestaurantBot
CAMPAY_BASE_URL=https://campay.net/api        # use demo.campay.net for testing
CAMPAY_WEBHOOK_URL=https://yourdomain.com/payments/webhook

# ── Mapbox (Driver Tracking Map) ──────────────────────────────────────────────
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your_mapbox_public_token
